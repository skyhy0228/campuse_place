  "routes": {
    "ict": {
      "title": "轻松上智能ICT馆路线",
      "desc": "不要直接爬坡，先乘大学本部（E8）大楼电梯上到大厅层，再从那里步行过去会轻松很多。"
    },
    "insa": {
      "title": "轻松前往人文社会馆路线",
      "desc": "先坐建筑馆（E12）电梯上去，再穿过天桥/通道到人文社会馆（E14），可以少爬很多楼梯和陡坡。"
    },
    "ridge": {
      "title": "建设环境馆 → 智能ICT馆高架路",
      "desc": "从建设环境馆沿着车行道旁人行道一直连到智能ICT馆的校园中央高架通道。"
    },
    "loop": {
      "title": "交通大环山步道一圈",
      "desc": "正门 → 科技馆 → 智能ICT馆 → 生活馆 → IT馆 → 研究生院 → 正门，适合散步的校内环线。"
    }
  },
