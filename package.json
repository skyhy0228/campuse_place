{
  "name": "campuse-place",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data": "node scripts/convert-data.mjs",
    "images": "node scripts/sync-images.mjs",
    "data:all": "npm run images && npm run data",
    "prebuild": "npm run data",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/make-assets.mjs",
    "test:unit": "node --test tests/unit",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e",
    "test": "npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.61.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
